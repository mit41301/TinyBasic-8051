                     321    ;
                     322    ;=======
                     323    ;
8050                 324    C_IN:
                     325    ;       Console character input routine.
                     326    ;       Waits for next input from console device and returns with character
                     327    ;       code in accumulator.
                     328    ;       If character is <CNTRL-C> process syntax error.
                     329    ;       Adjust lower-case alphabetics to upper case.
                     330    ;
8050                 331    DD005:  
8050 3098FD          332            JNB     RI,$            ;Wait until character received.
8053 E599            333            MOV     A,SBUF          ;Read input character.
8055 C298            334            CLR             RI                              ;Clear reception flag.
8057 547F            335            ANL             A,#7FH                  ;Mask off data bits.
8059 B40303          336            CJNE    A,#03H,C_IN_2   ;Test for CNTRL-C code.
805C 0280E8          337            JMP             SYN_ER                  ;Abort if detected.
                     338    ;
805F                 339    C_IN_2: 
805F B46100          340            CJNE    A,#'a',$+3              ;Check for lower-case alphabetics.
8062 4007            341            JC              C_IN_1
8064 B47B00          342            CJNE    A,#'z'+1,$+3
8067 5002            343            JNC             C_IN_1
8069 54DF            344            ANL             A,#11011111B    ;Force upper-case code.
806B                 345    C_IN_1: 
806B 22              346            RET                                             ;Return to calling routine.
                     347    ;
                     348    ;=======
                     349    ;
                     350    ;
806C                 351    NLINE:
                     352    ;       Transmit <CR><LF> sequence to console device.
                     353    ;
806C 740D            354            MOV     A,#CR
806E                 355    C_OUT:
                     356    ;       Console character output routine.
                     357    ;       Outputs character received in accumulator to console output device.
                     358    ;
806E                 359    DD006:  
806E 3099FD          360            JNB     TI,$            ;Wait until transmission completed.
8071                 361    DD007:  
8071 C299            362            CLR     TI              ;Clear interrupt flag.
8073 F599            363            MOV             SBUF,A                  ;Write out character.
8075 B40D0A          364            CJNE    A,#CR,COUT_2
8078                 365    DD008:  
8078 3099FD          366            JNB     TI,$
807B                 367    DD009:  
807B C299            368            CLR     TI
807D 75990A          369            MOV             SBUF,#LF                ;Output linefeed.
8080 8004            370            SJMP    COUT_3
TB51            Tiny-Basic51 - Modified for Metalink ASM51                                                    PAGE 7

                     371    ;
8082 C3              372    COUT_2: CLR     C
8083 D57604          373            DJNZ    TABCNT,COUT_1   ;Monitor output field position.
8086 757608          374    COUT_3: MOV     TABCNT,#TABSIZ  ;Reload field counter.
8089 D3              375            SETB    C
808A 22              376    COUT_1: RET
                     377    ;
                     378    ;=======
                     379    ;
                     380    ;
808B                 381    CNTRL:  
808B 30980A          382            JNB             RI,CNTRET               ;Poll whether character has been typed.
808E 1150            383            CALL    C_IN
8090 B41305          384            CJNE    A,#13H,CNTRET   ;Check if char. is <CNTRL-S>.
8093                 385    CNTR_2: 
8093 1150            386            CALL    C_IN                    ;If so, hang up...
8095 B411FB          387            CJNE    A,#11H,CNTR_2   ;    ...until <CNTRL-Q> received.
8098                 388    CNTRET: 
8098 22              389            RET
                     390    ;
                     391    ;=======
                     392    ;
                     393    ;
8099                 394    SPC:
                     395    ;       Transmit one or more space characters to console to move console
                     396    ;       cursor to start of next field.
                     397    ;
8099 7420            398            MOV             A,#' '                  ;Load ASCII code for space character.
809B 116E            399            CALL    C_OUT
809D 50FA            400            JNC             SPC                             ;Repeat until at TAB boundary.
809F 22              401            RET
                     402    ;
                     403    ;===============
                     404    ;
                     405    ;NIBOUT
                     406    ;       If low-order nibble in Acc. is non-zero or ZERSUP flag is cleared,
                     407    ;       output the corresponding ASCII value and clear ZERSUP flag.
                     408    ;       Otherwise return without affecting output or ZERSUP.
                     409    ;
80A0 540F            410    NIBOUT: ANL     A,#0FH          ;Mask out low-order bits.
80A2 7003            411            JNZ     NIBO_2          ;Output ASCII code for Acc contents.
80A4 200807          412            JB      ZERSUP,NIBO_3
80A7 C208            413    NIBO_2: CLR     ZERSUP          ;Mark that non-zero character encountered.
80A9 2403            414            ADD     A,#(ASCTBL-(NIBO_1+1))  ;Offset to start of table.
80AB 83              415    NIBO_1: MOVC    A,@A+PC         ;Look up corresponding code.
80AC 116E            416            CALL    C_OUT           ;Output character.
80AE 22              417    NIBO_3: RET
                     418    ;
80AF 30313233        419    ASCTBL: DB      '0123456789ABCDEF'
80B3 34353637   
80B7 38394142   
80BB 43444546   
