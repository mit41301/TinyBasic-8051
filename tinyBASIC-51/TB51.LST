                     959    ;=======
                     960    ;$EJECT
                     961    ;
                     962    ;CREATE
                     963    ;       Test the contents of Acc.
                     964    ;       If CHAR holds the ASCII code for a legitimate decimal digit,
                     965    ;       create a two-byte entry in <TOS_H><TOS_L> holding low-order ACC nibble
                     966    ;       and return with CY set.
                     967    ;       Otherwise, return with CY cleared.
                     968    ;
82B8 24D0            969    CREATE: ADD     A,#-'0'         ;Correct for ASCII digit offset.
82BA B40A00          970            CJNE    A,#10,$+3       ;Compare to maximum legal digit.
82BD 5005            971            JNC     CREA_1          ;Abort if first char is not decimal digit.
82BF FE              972            MOV     TOS_L,A         ;Save initial digit read.
82C0 7F00            973            MOV     TOS_H,#0        ;Clear high-order bits.
82C2 C20D            974            CLR     H_FLG
82C4 22              975    CREA_1: RET
                     976    ;
                     977    ;===============
                     978    ;
                     979    ;APPEND
                     980    ;       Test ASCII code in Acc.
                     981    ;       If it is a legal digit in the current radix,
                     982    ;       modify <TOS_H><TOS_L> to include this digit and return with CY set.
                     983    ;       Otherwise leave AES and CHAR unchanged and return with CY cleared.
                     984    ;       Operating mode determined by HEXMOD flag (1=Hex).
                     985    ;
82C5 200D3E          986    APPEND: JB      H_FLG,APND_2    ;Nothing allowed after trailing 'H' received.
82C8 24D0            987            ADD     A,#-'0'         ;Correct for ASCII offset.
82CA B40A00          988            CJNE    A,#10,$+3       ;Verify whether legal digit.
82CD 4013            989            JC      APND_1          ;Insert decimal digit as is.
82CF 300434          990            JNB     HEXMOD,APND_2   ;If in decimal mode, character isn't legal.
82D2 24EF            991            ADD     A,#'0'-'A'      ;Acc now equals 0 if 'A' received.
82D4 B40600          992            CJNE    A,#6,$+3
82D7 4007            993            JC      APND_4          ;Process Hex digit.
                     994    ;
                     995    ;       Char was not hexidecimal digit, but if it was the first 'H', that's OK.
                     996    ;
82D9 B4072A          997            CJNE    A,#'H'-'A',APND_2       ;Compare original input with 'H'.
82DC D20D            998            SETB    H_FLG           ;Mark that 'H' was detected but don't process.
82DE D3              999            SETB    C
82DF 22             1000            RET
                    1001    ;
82E0 240A           1002    APND_4: ADD     A,#10           ;Value of lowest hex digit.
82E2 CE             1003    APND_1: XCH     A,TOS_L         ;Save nibble to be appended.
82E3 75F00A         1004            MOV     B,#10           ;(Assuming radix=decimal.)
TB51            Tiny-Basic51 - Modified for Metalink ASM51                                                    PAGE 17

82E6 300403         1005            JNB     HEXMOD,XRAD_1   ;Skip ahead if assumption correct.
82E9 75F010         1006            MOV     B,#16           ;If mode is actually hex.
82EC C0F0           1007    XRAD_1: PUSH    B               ;Save for re-use.
82EE A4             1008            MUL     AB              ;Multiply by radix.
82EF 2E             1009            ADD     A,TOS_L         ;Append new digit.
82F0 FE             1010            MOV     TOS_L,A         ;Save low-order shifted value.
82F1 E4             1011            CLR     A
82F2 35F0           1012            ADDC    A,B             ;Incremented high-order product if carry.
82F4 CF             1013            XCH     A,TOS_H
