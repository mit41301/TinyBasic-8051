8593 91B6           1783    TSTS:   CALL    READ_CHAR
8595 F530           1784            MOV     TMP0,A
8597 6422           1785            XRL     A,#'"'
8599 6008           1786            JZ      TSTS_1
859B 6405           1787            XRL     A,#'''' XOR '"'
859D 6004           1788            JZ      TSTS_1
859F C3             1789            CLR     C
85A0 D209           1790            SETB    CHAR_FLG
85A2 22             1791            RET
                    1792    ;
85A3 91B6           1793    TSTS_1: CALL    READ_CHAR       ;Read next string character.
85A5 B53002         1794            CJNE    A,TMP0,TSTS_2
85A8 81D5           1795            JMP     D_BLNK
                    1796    ;
85AA 116E           1797    TSTS_2: CALL    C_OUT           ;Call output routine.
85AC B40DF4         1798            CJNE    A,#CR,TSTS_1    ;<CR> before closing quote is illegal.
85AF 01E8           1799            JMP     SYN_ER          ;Transmit error message.
                    1800    ;
