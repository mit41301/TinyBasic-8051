                    2410    ;
                    2411    ;$EJECT
                    2412    ;
                    2413    ;       IL SEQUENCE CONTROL INSTRUCTIONS:
                    2414    ;       == ======== ======= ============
TB51            Tiny-Basic51 - Modified for Metalink ASM51                                                    PAGE 39

                    2415    ;
                    2416    ;IJMP   (LBL)
                    2417    ;       Jump to the (potentially distant) IL instruction at location LBL.
                    2418    ;Note:  In this implementation IL addresses are equivalent to machine
                    2419    ;       language addresses, so IJMP performs a generic JMP.
                    2420    ;
                    2421    ;
                    2422    ;===============
                    2423    ;
                    2424    ;HOP    (LBL)
                    2425    ;       Perform a branch to the IL instruction at (nearby) location LBL.
                    2426    ;Note:  In this implementation IL addresses are equivalent to machine
                    2427    ;       language addresses, so HOP performs a simple relative SJMP.
                    2428    ;
                    2429    ;
                    2430    ;===============
                    2431    ;
                    2432    ;ICALL  (LBL)
                    2433    ;       Call the IL subroutine starting at instruction LBL.
                    2434    ;       Save the location of the next IL instruction on the control stack.
                    2435    ;Note:  In this implementation, IL addresses are identical with 
                    2436    ;       machine language addresses, and are saved on the MCS-51 hardware stack.
                    2437    ;
                    2438    ;
                    2439    ;===============
                    2440    ;
                    2441    ;IRET
                    2442    ;       Return from IL subroutine to location on top of control stack.
                    2443    ;Note:  In this implementation, IL addresses are identical with machine 
                    2444    ;       language addresses, which are saved on the hardware stack.
                    2445    ;
                    2446    ;
                    2447    ;===============
                    2448    ;
                    2449    ;MLCALL
                    2450    ;       Call the ML subroutine starting at the address on top of AES.
                    2451    ;
                    2452    ;
881B A950           2453    MLCALL: MOV     R1,AESP
881D 87F0           2454            MOV     B,@R1
881F 19             2455            DEC     R1
8820 E7             2456            MOV     A,@R1
8821 19             2457            DEC     R1
8822 8950           2458            MOV     AESP,R1
8824 C0E0           2459            PUSH    ACC
8826 C0F0           2460            PUSH    B
8828 43D018         2461            ORL     PSW,#00011000B  ;Select RB3.
882B 22             2462            RET                     ;Branch to user routine.
                    2463    ;
                    2464    ;=======
