                    1741    ;
                    1742    ;
857E 91B6           1743    TSTN:   CALL    READ_CHAR
8580 51B8           1744            CALL    CREATE          ;Create entry on AES if legit. digit.
8582 4003           1745            JC      TSTN_1          ;Abort if CHAR is not decimal digit.
8584 D209           1746            SETB    CHAR_FLG
8586 22             1747            RET
                    1748    ;
8587 91B6           1749    TSTN_1: CALL    READ_CHAR       ;Move over matched character.
8589 51C5           1750            CALL    APPEND          ;Append new digit to entry on TOS.
858B 40FA           1751            JC      TSTN_1          ;Continue processing while legal characters.
858D 310B           1752            CALL    PUSH_TOS
858F D209           1753            SETB    CHAR_FLG
8591 81D5           1754            JMP     D_BLNK          ;Remove leading blank characters.
                    1755    ;
                    1756    ;===============
                    1757    ;
                    1758    ;TSTL   (LBL)
                    1759    ;       Test if first non-blank string is a BASIC source line number.
                    1760    ;       If so, move cursor over string and following blanks,
                    1761    ;       compute number's binary value,
                    1762    ;       push onto arithmetic expression stack, 
                    1763    ;       and continue with next IL instruction.
                    1764    ;       If invalid source line number report syntax error.
                    1765    ;       If line number not present restore cursor
                    1766    ;       and branch to IL instruction at LBL.
                    1767    ;
                    1768    ;
                    1769    ;===============
                    1770    ;
                    1771    ;TSTS   (LBL)
