84D5 91B6           1575            CALL    READ_CHAR
84D7 6420           1576            XRL     A,#' '          ;Verify that it is non-blank.
84D9 60FA           1577            JZ      D_BLNK          ;Loop until non-blank leading character.
84DB D209           1578            SETB    CHAR_FLG
84DD D3             1579            SETB    C
84DE 22             1580            RET                     ;Return to scanning code.
