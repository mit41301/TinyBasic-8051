                    1802    ;
                    1803    ;DONE
                    1804    ;       Delete leading blanks from the BASIC source line.
                    1805    ;       Return with the cursor positioned over the first non-blank
                    1806    ;       character, which must be a colon or <CR> in the source line.
                    1807    ;       If any other characters are encountered report a syntax error.
                    1808    ;
                    1809    ;
                    1810    ;
85B1 91B6           1811    DONE:   CALL    READ_CHAR
85B3 BC3A03         1812            CJNE    CHAR,#':',DONE_1        ;Colon indicates resume interpretation.
85B6 22             1813            RET                     ;Return to IL.
                    1814    ;
85B7 91B6           1815    LNDONE: CALL    READ_CHAR
85B9 BC0D01         1816    DONE_1: CJNE    CHAR,#CR,DONE_2 ;Any non-colon, non-CR characters are illegal.
85BC 22             1817            RET
                    1818    ;
85BD D209           1819    DONE_2: SETB    CHAR_FLG
85BF 01E8           1820            JMP     SYN_ER          ;Process syntax error if so.
                    1821    ;
                    1822    ;=======
                    1823    ;
                    1824    ;IFDONE (LBL)
                    1825    ;       If the first non-blank character is a colon or <CR> in the source line
                    1826    ;       then branch to the IL instruction specified by (LBL).
                    1827    ;       If any other characters are encountered
                    1828    ;       then continue with next IL instruction.
