8526 918B           1668    ALPHAB: CALL    SAVE_PNTR       ;In case variable name not found.
8528 91B6           1669            CALL    READ_CHAR       ;Verify that next character is not alphabetic.
852A 24BF           1670            ADD     A,#-'A'         ;Alphabetic characters now <= 25.
852C 24E6           1671            ADD     A,#-26          ;Non-alphabetics cause overflow.
852E 5003           1672            JNC     NOTVAR          ;Alphabetic character means illegal var. name.
8530 BC2E40         1673            CJNE    CHAR,#'.',TSTV_1        ;Period indicates abbreviated keyword.
8533 9192           1674    NOTVAR: CALL    LOAD_PNTR
8535 D209           1675            SETB    CHAR_FLG
