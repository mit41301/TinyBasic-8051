                     473    ;       ARITHMETIC SUBROUTINE PACKAGE  (8/12/80)
                     474    ;
                     475    ;=======
                     476    ;
80F3                 477    POP_TOS:
                     478    ;       Verify that stack holds at least one (16-bit) entry.
                     479    ;       (Call AES_ER otherwise.)
                     480    ;       Pop TOS into registers TOS_H and TOS_L,
                     481    ;       update AESP,
                     482    ;       and return with R1 pointing to low-order byte of previous NOS.
                     483    ;       Do not affect accumulator contents.
                     484    ;
80F3 A950            485            MOV     R1,AESP
80F5 B95200          486            CJNE    R1,#AES+1,$+3   ;Compare pointer with min. legal level.
80F8 4021            487            JC      STK_ER
80FA FE              488            MOV     TOS_L,A
80FB E7              489            MOV     A,@R1
80FC FF              490            MOV     TOS_H,A
80FD 19              491            DEC     R1
80FE E7              492            MOV     A,@R1
TB51            Tiny-Basic51 - Modified for Metalink ASM51                                                    PAGE 9

80FF CE              493            XCH     A,TOS_L         ;Store byte and reload ACC.
8100 19              494            DEC     R1
8101 8950            495            MOV     AESP,R1
8103 19              496            DEC     R1
8104 22              497            RET
                     498    ;
                     499    ;=======
                     500    ;
8105                 501    POP_ACC:
                     502    ;       Pop TOS into accumulator and update AESP.
                     503    ;
8105 A950            504            MOV     R1,AESP
8107 E7              505            MOV     A,@R1
8108 1550            506            DEC     AESP
810A 22              507            RET
                     508    ;
                     509    ;=======
                     510    ;
810B                 511    PUSH_TOS:
                     512    ;       Verify that the AES is not full,
                     513    ;       push registers TOS_H and TOS_L onto AES,
                     514    ;       and update AESP.
                     515    ;
810B A950            516            MOV     R1,AESP
810D B97300          517            CJNE    R1,#AES+AESLEN-2,$+3    ;Compare pointer with max. legal level.
8110 5009            518            JNC     STK_ER
8112 09              519            INC     R1
8113 EE              520            MOV     A,TOS_L         ;Push low-order byte.
8114 F7              521            MOV     @R1,A
8115 09              522            INC     R1
8116 EF              523            MOV     A,TOS_H         ;Push high-order byte.
8117 F7              524            MOV     @R1,A
8118 8950            525            MOV     AESP,R1
811A 22              526            RET
