844D A950           1392            MOV     R1,AESP
844F 19             1393            DEC     R1
8450 C3             1394            CLR     C               ;...in preparation for string subtract.
8451 E7             1395            MOV     A,@R1           ;Compare low-order parameter bytes.
8452 9E             1396            SUBB    A,TOS_L
8453 09             1397            INC     R1              ;Bump pointer.
8454 C7             1398            XCH     A,@R1           ;Save difference.
8455 200406         1399            JB      HEXMOD,CMPR_4
