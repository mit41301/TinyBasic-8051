                    1611    ;
84E9 D083           1612            POP     DPH             ;Get in-line parameter base address from stack.
84EB D082           1613            POP     DPL
84ED 91B6           1614            CALL    READ_CHAR
84EF 918B           1615            CALL    SAVE_PNTR
84F1 E4             1616    TST_1:  CLR     A
84F2 93             1617            MOVC    A,@A+DPTR       ;Read next character from template string.
84F3 A2E7           1618            MOV     C,ACC.7         ;Save terminator bit.
84F5 547F           1619            ANL     A,#7FH          ;Mask off terminator.
84F7 6C             1620            XRL     A,CHAR          ;Compare with template.
84F8 7012           1621            JNZ     T_BAD           ;Abort if first characters miscompare.
84FA A3             1622            INC     DPTR            ;Pass over template character just checked.
84FB 400B           1623            JC      T_GOOD          ;Done if template character bit 7 set.
84FD 91B6           1624            CALL    READ_CHAR       ;Fetch next character for test.
84FF BC2EEF         1625            CJNE    CHAR,#'.',TST_1 ;Done if input string abbreviated at this point
8502 E4             1626    TST_2:  CLR     A               ;Fetch template characters until end of string
8503 93             1627            MOVC    A,@A+DPTR
8504 A3             1628            INC     DPTR
8505 30E7FA         1629            JNB     ACC.7,TST_2     ;Loop until last character detected.
8508 91D5           1630    T_GOOD: CALL    D_BLNK
850A E4             1631            CLR     A
850B 73             1632            JMP     @A+DPTR         ;Return to next IL instruction
                    1633    ;
                    1634    ;       Strings do not match.  Leave cursor at start of string.
                    1635    ;
850C E4             1636    T_BAD:  CLR     A
850D 93             1637            MOVC    A,@A+DPTR       ;Search for final template character.
850E A3             1638            INC     DPTR
